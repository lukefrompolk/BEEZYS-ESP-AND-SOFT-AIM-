--==================================================
-- DRAGGABLE MENU
--==================================================

local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = panel.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        panel.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

--==================================================
-- ESP CLEANUP
--==================================================

local function removeESP(player)
    local objects = tracked[player]

    if objects then
        for _, object in ipairs(objects) do
            object:Destroy()
        end

        tracked[player] = nil
    end
end

--==================================================
-- CREATE PLAYER ESP
--==================================================

local function createESP(player, character)
    removeESP(player)

    if not espEnabled or player == LocalPlayer then
        return
    end

    local humanoid = character:WaitForChild("Humanoid", 5)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    local head = character:WaitForChild("Head", 5)

    if not humanoid or not root or not head then
        return
    end

    if not espEnabled or not character.Parent then
        return
    end

    local objects = {}

    -- Character glow
    local highlight = Instance.new("Highlight")
    highlight.Name = "BeezysGlow"
    highlight.Adornee = character
    highlight.FillColor = GREEN
    highlight.OutlineColor = GREEN
    highlight.FillTransparency = 0.88
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    table.insert(objects, highlight)

    -- Player name and health display
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "BeezysPlayerInfo"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(170, 45)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = PlayerGui

    local info = Instance.new("TextLabel")
    info.Size = UDim2.fromScale(1, 1)
    info.BackgroundTransparency = 1
    info.TextColor3 = GREEN
    info.TextStrokeTransparency = 0.3
    info.TextSize = 13
    info.Font = Enum.Font.GothamBold
    info.Parent = billboard

    table.insert(objects, billboard)

    -- Circle around character
    local circleGui = Instance.new("BillboardGui")
    circleGui.Name = "BeezysCircle"
    circleGui.Adornee = root
    circleGui.Size = UDim2.fromOffset(65, 65)
    circleGui.AlwaysOnTop = true
    circleGui.Parent = PlayerGui

    local circle = Instance.new("Frame")
    circle.Size = UDim2.fromScale(1, 1)
    circle.BackgroundTransparency = 1
    circle.Parent = circleGui

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle

    local circleLine = Instance.new("UIStroke")
    circleLine.Color = GREEN
    circleLine.Thickness = 2
    circleLine.Transparency = 0.15
    circleLine.Parent = circle

    table.insert(objects, circleGui)

    tracked[player] = {
        objects = objects,
        info = info,
        humanoid = humanoid
    }
end

--==================================================
-- ESP TOGGLE
--==================================================

local function refreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if espEnabled then
                if player.Character then
                    task.spawn(createESP, player, player.Character)
                end
            else
                removeESP(player)
            end
        end
    end
end

espButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled

    espButton.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    espButton.TextColor3 = espEnabled and GREEN or WHITE

    refreshESP()
end)

