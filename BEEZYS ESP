-- INPUT
UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
        return
    end

    if processed then return end

    if input.KeyCode == Enum.KeyCode.W
        or input.KeyCode == Enum.KeyCode.A
        or input.KeyCode == Enum.KeyCode.S
        or input.KeyCode == Enum.KeyCode.D then

        keysDown[input.KeyCode] = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    keysDown[input.KeyCode] = nil
end)

-- FLIGHT HELPERS
local function stopFlight()
    if flightVelocity then
        flightVelocity:Destroy()
        flightVelocity = nil
    end

    if flightGyro then
        flightGyro:Destroy()
        flightGyro = nil
    end
end

local function startFlight(root)
    stopFlight()

    flightVelocity = Instance.new("BodyVelocity")
    flightVelocity.MaxForce = Vector3.new(1000000, 1000000, 1000000)
    flightVelocity.Velocity = Vector3.zero
    flightVelocity.Parent = root

    flightGyro = Instance.new("BodyGyro")
    flightGyro.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
    flightGyro.P = 10000
    flightGyro.CFrame = camera.CFrame
    flightGyro.Parent = root
end

-- MAIN UPDATE
RunService.RenderStepped:Connect(function()
    local color = rainbow()

    border.Color = color
    fovStroke.Color = color

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    -- WALK SPEED
    if humanoid and not settings.Fly then
        humanoid.WalkSpeed = settings.WalkSpeed
    end

    -- PLAYER ESP
    for target, data in pairs(espObjects) do
        local alive = target.Parent == Players
            and data.humanoid
            and data.humanoid.Health > 0

        if data.highlight then
            data.highlight.Enabled = settings.ESP and alive
            data.highlight.OutlineColor = color
            data.highlight.FillColor = color
        end

        if data.billboard then
            data.billboard.Enabled = settings.ESP and alive
        end

        if alive and data.info then
            local parts = {}

            if settings.Names then
                table.insert(parts, target.DisplayName)
            end

            if settings.Health then
                table.insert(parts, "HP: " .. math.floor(data.humanoid.Health))
            end

            data.info.Text = table.concat(parts, "  |  ")
            data.info.TextColor3 = color
        end
    end

    -- FLIGHT
    if settings.Fly and root then
        if not flightVelocity then
            startFlight(root)
        end

        local direction = Vector3.zero

        if keysDown[Enum.KeyCode.W] then
            direction += camera.CFrame.LookVector
        end

        if keysDown[Enum.KeyCode.S] then
            direction -= camera.CFrame.LookVector
        end

        if keysDown[Enum.KeyCode.D] then
            direction += camera.CFrame.RightVector
        end

        if keysDown[Enum.KeyCode.A] then
            direction -= camera.CFrame.RightVector
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        flightVelocity.Velocity = direction * settings.FlySpeed
        flightGyro.CFrame = camera.CFrame
        humanoid.PlatformStand = true
    else
        if flightVelocity or flightGyro then
            stopFlight()

            if humanoid then
                humanoid.PlatformStand = false
            end
        end
    end
end)

