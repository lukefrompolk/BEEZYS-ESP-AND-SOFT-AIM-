--==================================================
-- TARGET HELPERS
--==================================================

local function getTargetPart(character)
    if not character then return nil end

    if Config.AimPart == "Head" then
        return character:FindFirstChild("Head")
    end

    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function isValidTarget(character, targetPlayer)
    if not character or character == Player.Character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    if targetPlayer and Config.TeamCheck
        and Player.Team ~= nil
        and targetPlayer.Team == Player.Team then
        return false
    end

    return true
end

local function getTargets()
    local targets = {}

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= Player and other.Character then
            table.insert(targets, {
                Character = other.Character,
                Player = other
            })
        end
    end

    if TargetFolder then
        for _, model in ipairs(TargetFolder:GetChildren()) do
            if model:IsA("Model") then
                table.insert(targets, {
                    Character = model,
                    Player = nil
                })
            end
        end
    end

    return targets
end

--==================================================
-- AIM ASSIST
--==================================================

local function getClosestTarget()
    local closest = nil
    local shortest = Config.FOV

    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    for _, target in ipairs(getTargets()) do
        local character = target.Character

        if isValidTarget(character, target.Player) then
            local part = getTargetPart(character)

            if part then
                local screenPosition, visible =
                    Camera:WorldToViewportPoint(part.Position)

                if visible and screenPosition.Z > 0 then
                    local distance = (
                        Vector2.new(screenPosition.X, screenPosition.Y)
                        - center
                    ).Magnitude

                    if distance < shortest then
                        shortest = distance
                        closest = part
                    end
                end
            end
        end
    end

    return closest
end

--==================================================
-- ESP HIGHLIGHTS
--==================================================

local Highlights = {}

local function removeHighlight(character)
    local highlight = Highlights[character]

    if highlight then
        highlight:Destroy()
        Highlights[character] = nil
    end
end

local function updateHighlights()
    local active = {}

    if Config.ESP then
        for _, target in ipairs(getTargets()) do
            local character = target.Character

            if isValidTarget(character, target.Player) then
                active[character] = true

                if Config.ESPStyle == "Highlight" then
                    if not Highlights[character] then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "B33ZYS_ESP"
                        highlight.Adornee = character
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = GUI

                        Highlights[character] = highlight
                    end

                    Highlights[character].FillColor = Config.ESPColor
                    Highlights[character].OutlineColor = Config.ESPColor
                    Highlights[character].FillTransparency = 0.75
                    Highlights[character].OutlineTransparency = 0
                else
                    removeHighlight(character)
                end
            end
        end
    end

    if Config.ShowSelf and Player.Character then
        active[Player.Character] = true

        if not Highlights[Player.Character] then
            local highlight = Instance.new("Highlight")
            highlight.Name = "B33ZYS_SELF"
            highlight.Adornee = Player.Character
            highlight.Parent = GUI
            Highlights[Player.Character] = highlight
        end

        Highlights[Player.Character].FillColor = Config.ESPColor
        Highlights[Player.Character].OutlineColor = Config.ESPColor
    else
        if Player.Character then
            removeHighlight(Player.Character)
        end
    end

    for character in pairs(Highlights) do
        if not active[character] then
            removeHighlight(character)
        end
    end
end

--==================================================
-- FLIGHT
--==================================================

local BodyVelocity
local BodyGyro

local function stopFlight()
    if BodyVelocity then
        BodyVelocity:Destroy()
        BodyVelocity = nil
    end

    if BodyGyro then
        BodyGyro:Destroy()
        BodyGyro = nil
    end
end

local function updateFlight()
    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not Config.Fly or not root then
        stopFlight()
        return
    end

    if not BodyVelocity then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        BodyVelocity.Parent = root

        BodyGyro = Instance.new("BodyGyro")
        BodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        BodyGyro.P = 10000
        BodyGyro.Parent = root
    end

    local direction = Vector3.zero

    if UIS:IsKeyDown(Enum.KeyCode.W) then
        direction += Camera.CFrame.LookVector
    end

    if UIS:IsKeyDown(Enum.KeyCode.S) then
        direction -= Camera.CFrame.LookVector
    end

    if UIS:IsKeyDown(Enum.KeyCode.D) then
        direction += Camera.CFrame.RightVector
    end

    if UIS:IsKeyDown(Enum.KeyCode.A) then
        direction -= Camera.CFrame.RightVector
    end

    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        direction += Vector3.yAxis
    end

    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        direction -= Vector3.yAxis
    end

    BodyVelocity.Velocity =
        direction.Magnitude > 0
        and direction.Unit * Config.FlySpeed
        or Vector3.zero

    BodyGyro.CFrame = Camera.CFrame
end

--==================================================
-- MAIN UPDATE
--==================================================

local updateTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)
    if not GUI.Parent then return end

    Camera = workspace.CurrentCamera

    local center = Camera.ViewportSize / 2

    Circle.Position = UDim2.fromOffset(center.X, center.Y)
    Circle.Size = UDim2.fromOffset(Config.FOV * 2, Config.FOV * 2)
    Circle.Visible = Config.AimAssist
    CircleStroke.Color = Config.FOVColor

    if Config.AimAssist then
        local target = getClosestTarget()

        if target then
            local desired = CFrame.lookAt(
                Camera.CFrame.Position,
                target.Position
            )

            local alpha = math.clamp(
                1 / Config.Smoothness,
                0.01,
                1
            )

            Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
        end
    end

    updateFlight()

    updateTimer += deltaTime

    if updateTimer >= 0.15 then
        updateTimer = 0
        updateHighlights()
    end
end)

