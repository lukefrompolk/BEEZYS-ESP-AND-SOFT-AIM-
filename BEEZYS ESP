local function makeButton(text, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 34)
    button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.Text = text
    button.Parent = controls

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Parent = button

    button.Activated:Connect(callback)

    return button, stroke
end

local function makeSetting(label, minimum, maximum, initial, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -5, 0, 48)
    holder.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    holder.Parent = controls
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 6)

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -90, 1, 0)
    text.Position = UDim2.fromOffset(8, 0)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Font = Enum.Font.GothamBold
    text.TextSize = 12
    text.Parent = holder

    local value = initial

    local function refresh()
        text.Text = label .. ": " .. value
    end

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.fromOffset(30, 28)
    minus.Position = UDim2.new(1, -72, 0.5, -14)
    minus.Text = "-"
    minus.TextSize = 18
    minus.Font = Enum.Font.GothamBold
    minus.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    minus.TextColor3 = Color3.new(1, 1, 1)
    minus.Parent = holder

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.fromOffset(30, 28)
    plus.Position = UDim2.new(1, -36, 0.5, -14)
    plus.Text = "+"
    plus.TextSize = 18
    plus.Font = Enum.Font.GothamBold
    plus.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    plus.TextColor3 = Color3.new(1, 1, 1)
    plus.Parent = holder

    local function change(amount)
        value = math.clamp(value + amount, minimum, maximum)
        refresh()
        callback(value)
    end

    minus.Activated:Connect(function()
        change(-5)
    end)

    plus.Activated:Connect(function()
        change(5)
    end)

    refresh()
end

