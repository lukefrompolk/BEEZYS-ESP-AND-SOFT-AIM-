-- ESP CLEANUP
local function removeESP(target)
    local data = espObjects[target]
    if not data then return end

    if data.highlight then
        data.highlight:Destroy()
    end

    if data.billboard then
        data.billboard:Destroy()
    end

    espObjects[target] = nil
end

-- CREATE ESP
local function createESP(target)
    if target == player then return end

    local function setupCharacter(character)
        removeESP(target)

        local humanoid = character:WaitForChild("Humanoid", 5)
        local root = character:WaitForChild("HumanoidRootPart", 5)

        if not humanoid or not root then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "BeezysHighlight"
        highlight.Adornee = character
        highlight.FillTransparency = 0.85
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = character

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "BeezysPlayerInfo"
        billboard.Adornee = root
        billboard.Size = UDim2.fromOffset(180, 45)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = player:WaitForChild("PlayerGui")

        local info = Instance.new("TextLabel")
        info.Size = UDim2.fromScale(1, 1)
        info.BackgroundTransparency = 1
        info.TextColor3 = Color3.new(1, 1, 1)
        info.TextStrokeTransparency = 0
        info.Font = Enum.Font.GothamBold
        info.TextSize = 13
        info.Parent = billboard

        espObjects[target] = {
            highlight = highlight,
            billboard = billboard,
            info = info,
            humanoid = humanoid
        }
    end

    if target.Character then
        task.spawn(setupCharacter, target.Character)
    end

    target.CharacterAdded:Connect(setupCharacter)
end

for _, target in ipairs(Players:GetPlayers()) do
    createESP(target)
end

Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

